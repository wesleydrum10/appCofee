# Desenvolvimento. Substitua os placeholders antes de iniciar.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=

APP_PORT=8000
POSTGRES_DB=appcoffee
POSTGRES_USER=appcoffee
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sem Docker: use POSTGRES_HOST=localhost ou defina DATABASE_URL PostgreSQL.
# Render: DEBUG=False e DATABASE_URL do Neon com sslmode=require.
# Não envie este .env ao Render; configure as variáveis no painel.
